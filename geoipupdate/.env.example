# Exemplo de configuração para geoipupdate
# Copie este arquivo para .env e preencha com suas credenciais MaxMind
# ATENÇÃO: Nunca versione o arquivo .env com as credenciais reais

# ID da conta MaxMind (obrigatório)
GEOIPUPDATE_ACCOUNT_ID=MUDE_PARA_SEU_ID

# Chave de licença MaxMind (obrigatório) - GUARDE COMO SEGREDO
GEOIPUPDATE_LICENSE_KEY=MUDE_PARA_SUA_CHAVE

# IDs das bases a atualizar separadas por espaço
# Opções comuns:
#   GeoLite2-City (gratuita)
#   GeoLite2-Country (gratuita)
#   GeoLite2-ASN (gratuita)
#   GeoIP2-City (premium)
#   GeoIP2-Country (premium)
GEOIPUPDATE_EDITION_IDS=GeoLite2-City GeoLite2-Country GeoLite2-ASN

# Frequência de atualização em horas
# 0 = atualizar uma vez e sair
# 48 = atualizar a cada 48 horas (recomendado para produção)
GEOIPUPDATE_FREQUENCY=48

# Ativar logging verboso
# 0 = desativado
# 1 = ativado
GEOIPUPDATE_VERBOSE=1

# Configurações opcionais de proxy
# HTTP_PROXY=http://proxy.example.com:80
# NO_PROXY=localhost,127.0.0.1
